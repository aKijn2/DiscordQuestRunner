<ContentPage
    x:Class="DiscordQuestRunner.Pages.DeleterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Deleter Protocol"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"
    NavigationPage.HasNavigationBar="False">

    <Grid
        Padding="20,16,20,20"
        RowDefinitions="Auto, Auto, Auto, *, Auto"
        RowSpacing="16">

        <!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto, *, Auto">
            <!-- Title -->
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <BoxView
                        BackgroundColor="#FF5F56"
                        CornerRadius="2"
                        HeightRequest="20"
                        WidthRequest="4"
                        VerticalOptions="Center" />
                    <Label
                        CharacterSpacing="4"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="NEXUS :: PURGE"
                        TextColor="#FF5F56"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Margin="12,0,0,0"
                    Text="MESSAGE PURGE"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <!-- Status badge -->
            <Border
                Grid.Column="2"
                Padding="12,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="3" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Ellipse
                        x:Name="StatusDot"
                        Fill="#FFBD2E"
                        HeightRequest="8"
                        VerticalOptions="Center"
                        WidthRequest="8" />
                    <Label
                        x:Name="StatusBadgeLbl"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="STANDBY"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ INPUT PANEL ══════════════════════════════════════════════════ -->
        <Border
            Grid.Row="1"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.2" Offset="0,4" Radius="10" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Channel ID -->
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <HorizontalStackLayout Spacing="6">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="CHANNEL_ID"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="10"
                            Text="*"
                            TextColor="#FF5F56"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border
                        Padding="10,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                        Stroke="{StaticResource PrimaryDark}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Entry
                            x:Name="ChannelIdEntry"
                            BackgroundColor="Transparent"
                            FontFamily="Consolas"
                            FontSize="13"
                            HeightRequest="38"
                            Keyboard="Numeric"
                            Placeholder="000000000000000000"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </Border>
                </VerticalStackLayout>

                <!-- User ID -->
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <HorizontalStackLayout Spacing="6">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="USER_ID"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="10"
                            Text="*"
                            TextColor="#FF5F56"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border
                        Padding="10,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                        Stroke="{StaticResource PrimaryDark}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Entry
                            x:Name="UserIdEntry"
                            BackgroundColor="Transparent"
                            FontFamily="Consolas"
                            FontSize="13"
                            HeightRequest="38"
                            Keyboard="Numeric"
                            Placeholder="000000000000000000"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ═══ STATS ROW ════════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*, *, *"
            ColumnSpacing="10">

            <!-- Found -->
            <Border
                Grid.Column="0"
                Padding="12,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Offset="0,3" Radius="6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label
                        x:Name="FoundCountLbl"
                        FontAttributes="Bold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="—"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        CharacterSpacing="1"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="FOUND"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Deleted -->
            <Border
                Grid.Column="1"
                Padding="12,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                Stroke="#FF5F56"
                StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#FF5F56" Opacity="0.2" Offset="0,3" Radius="8" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label
                        x:Name="DeletedCountLbl"
                        FontAttributes="Bold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="—"
                        TextColor="#FF5F56" />
                    <Label
                        CharacterSpacing="1"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="DELETED"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress -->
            <Border
                Grid.Column="2"
                Padding="12,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Offset="0,3" Radius="6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label
                        x:Name="ProgressPctLbl"
                        FontAttributes="Bold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="—"
                        TextColor="{StaticResource Primary}" />
                    <Label
                        CharacterSpacing="1"
                        FontSize="10"
                        HorizontalOptions="Center"
                        Text="PROGRESS"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ═══ PURGE LOG ════════════════════════════════════════════════════ -->
        <Border
            Grid.Row="3"
            BackgroundColor="{StaticResource MidnightBlue}"
            Stroke="{StaticResource Primary}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, *">

                <!-- Toolbar -->
                <Grid
                    Grid.Row="0"
                    Padding="12,7"
                    BackgroundColor="#121218"
                    ColumnDefinitions="Auto, *, Auto"
                    ColumnSpacing="8">
                    <HorizontalStackLayout
                        Grid.Column="0"
                        Spacing="5"
                        VerticalOptions="Center">
                        <Ellipse Fill="#FF5F56" HeightRequest="9" WidthRequest="9" />
                        <Ellipse Fill="#FFBD2E" HeightRequest="9" WidthRequest="9" />
                        <Ellipse Fill="#27C93F" HeightRequest="9" WidthRequest="9" />
                    </HorizontalStackLayout>

                    <Label
                        Grid.Column="1"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        FontSize="10"
                        Margin="10,0,0,0"
                        Text="PURGE LOG"
                        TextColor="{StaticResource Gray400}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="2"
                        Padding="12,0"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Clicked="OnCopyLogClicked"
                        CornerRadius="3"
                        FontAttributes="Bold"
                        FontSize="10"
                        CharacterSpacing="1"
                        HeightRequest="26"
                        Text="SAVE"
                        TextColor="{StaticResource Primary}" />
                </Grid>

                <!-- Progress bar (shown during active purge) -->
                <ProgressBar
                    x:Name="PurgeProgress"
                    Grid.Row="1"
                    BackgroundColor="#1A1A22"
                    HeightRequest="3"
                    IsVisible="False"
                    Progress="0"
                    ProgressColor="{StaticResource Primary}" />

                <!-- Log output -->
                <ScrollView
                    x:Name="LogScroll"
                    Grid.Row="2"
                    Padding="14,12">
                    <Label
                        x:Name="StatusLbl"
                        FontFamily="Consolas"
                        FontSize="12"
                        LineHeight="1.6"
                        Text="> AWAITING DEPLOYMENT PARAMETERS..."
                        TextColor="{StaticResource Secondary}" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- ═══ ACTION BAR ═══════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="10"
            Margin="0,0,0,10">

            <!-- Spinner cell -->
            <Border
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                HeightRequest="46"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                WidthRequest="46">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    HeightRequest="20"
                    HorizontalOptions="Center"
                    IsRunning="False"
                    IsVisible="False"
                    VerticalOptions="Center"
                    WidthRequest="20"
                    Color="{StaticResource Primary}" />
            </Border>

            <!-- Primary action -->
            <Button
                x:Name="DeleteBtn"
                Grid.Column="1"
                BackgroundColor="#FF5F56"
                Clicked="OnDeleteClicked"
                CornerRadius="8"
                CharacterSpacing="2"
                FontAttributes="Bold"
                FontSize="14"
                HeightRequest="46"
                Text="START PURGE"
                TextColor="White">
                <Button.Shadow>
                    <Shadow Brush="#FF5F56" Opacity="0.4" Offset="0,4" Radius="12" />
                </Button.Shadow>
            </Button>

            <!-- Abort -->
            <Button
                x:Name="AbortBtn"
                Grid.Column="2"
                BackgroundColor="Transparent"
                BorderColor="{StaticResource Magenta}"
                BorderWidth="1.5"
                Clicked="OnAbortClicked"
                CornerRadius="8"
                FontAttributes="Bold"
                FontSize="12"
                HeightRequest="46"
                IsEnabled="False"
                Text="ABORT"
                TextColor="{StaticResource Magenta}"
                WidthRequest="80" />
        </Grid>

        <!-- ═══ MODAL OVERLAY ════════════════════════════════════════════════ -->
        <Grid
            x:Name="ModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="5"
            BackgroundColor="Transparent"
            IsVisible="False"
            Opacity="0"
            ZIndex="999">
            <Border
                Padding="22"
                BackgroundColor="{StaticResource MidnightBlue}"
                HorizontalOptions="Center"
                Stroke="#FF5F56"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="340">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <!-- Modal header -->
                    <HorizontalStackLayout Spacing="10">
                        <BoxView
                            BackgroundColor="#FF5F56"
                            CornerRadius="2"
                            HeightRequest="18"
                            WidthRequest="3"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="AlertTitleLbl"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="PURGE CONFIRMATION"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <BoxView BackgroundColor="{StaticResource BorderDark}" HeightRequest="1" />

                    <Label
                        x:Name="AlertMessageLbl"
                        FontSize="13"
                        LineHeight="1.5"
                        Text="..."
                        TextColor="{StaticResource Gray200}" />

                    <Grid
                        Margin="0,6,0,0"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="10">
                        <Button
                            x:Name="AlertCancelBtn"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray600}"
                            BorderWidth="1"
                            Clicked="OnAlertCancelClicked"
                            CornerRadius="4"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Cancel"
                            TextColor="{StaticResource Gray300}" />

                        <Button
                            x:Name="AlertConfirmBtn"
                            Grid.Column="1"
                            BackgroundColor="#FF5F56"
                            Clicked="OnAlertConfirmClicked"
                            CornerRadius="4"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Confirm Purge"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
