<ContentPage
    x:Class="DiscordQuestRunner.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid Padding="25" RowDefinitions="Auto, Auto, *" RowSpacing="30">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
            
            <VerticalStackLayout Grid.Column="0" Spacing="-2">
                <Label 
                    Text="NEXUS" 
                    FontSize="14" 
                    FontAttributes="Bold" 
                    TextColor="{StaticResource PrimaryDark}" 
                    CharacterSpacing="4" />
                <Label 
                    Text="Quest Automator" 
                    FontSize="26" 
                    FontAttributes="Bold" 
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <Border 
                Grid.Column="1" 
                BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                Padding="12,8" 
                VerticalOptions="Center"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Ellipse Fill="{StaticResource Magenta}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                    <Label 
                        Text="SYSTEM READY" 
                        FontSize="10" 
                        FontAttributes="Bold" 
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" 
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Border 
            Grid.Row="1" 
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" 
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                
                <Button 
                    x:Name="RunBtn" 
                    Clicked="OnRunClicked" 
                    Text="INITIALIZE QUESTS" 
                    FontSize="15" 
                    FontAttributes="Bold" 
                    CharacterSpacing="1.5"
                    HeightRequest="60" 
                    CornerRadius="16" 
                    TextColor="White">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="1,0">
                            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Magenta}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="15" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Button 
                        Grid.Column="0" 
                        Clicked="OnOpenDeleterClicked" 
                        Text="MESSAGE DELETER" 
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="48" 
                        CornerRadius="12" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource BtnSecondaryBgLight}, Dark={StaticResource BtnSecondaryBgDark}}" 
                        TextColor="{AppThemeBinding Light={StaticResource BtnSecondaryTextLight}, Dark={StaticResource BtnSecondaryTextDark}}" />
                    
                    <Border 
                        Grid.Column="1" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}" 
                        StrokeThickness="0" 
                        WidthRequest="48" 
                        HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <ActivityIndicator 
                            x:Name="LoadingIndicator" 
                            IsRunning="False" 
                            IsVisible="False" 
                            Color="{StaticResource Magenta}" 
                            WidthRequest="20" 
                            HeightRequest="20" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border 
            Grid.Row="2" 
            BackgroundColor="{StaticResource MidnightBlue}" 
            StrokeThickness="1"
            Stroke="{StaticResource Primary}"
            Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, *">
                
                <Grid Grid.Row="0" BackgroundColor="#000000" Opacity="0.4" Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                    <Label 
                        Grid.Column="0" 
                        Text=">_" 
                        FontFamily="Consolas" 
                        FontSize="14" 
                        FontAttributes="Bold" 
                        TextColor="{StaticResource PrimaryDark}" 
                        VerticalOptions="Center" />
                    
                    <Label 
                        Grid.Column="1" 
                        Text="RUNTIME LOG" 
                        FontSize="11" 
                        FontAttributes="Bold" 
                        CharacterSpacing="1"
                        TextColor="{StaticResource Gray300}" 
                        VerticalOptions="Center" 
                        Margin="10,0,0,0"/>

                    <Button 
                        Grid.Column="2" 
                        Text="COPY" 
                        Clicked="OnCopyLogClicked" 
                        FontSize="10" 
                        FontAttributes="Bold" 
                        Padding="15,0" 
                        HeightRequest="28" 
                        CornerRadius="6" 
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="White" />
                </Grid>

                <ScrollView x:Name="LogScroll" Grid.Row="1" Padding="15,10,15,15">
                    <Label 
                        x:Name="StatusLbl" 
                        Text="[SYS] Connecting to Discord API...&#10;[SYS] Awaiting authorization...&#10;[SYS] Standing by." 
                        FontFamily="Consolas" 
                        FontSize="12" 
                        TextColor="{StaticResource Secondary}" 
                        LineHeight="1.5" />
                </ScrollView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>