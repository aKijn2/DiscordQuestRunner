<ContentPage
    x:Class="DiscordQuestRunner.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"
    NavigationPage.HasNavigationBar="False">

    <Grid
        Padding="20"
        RowDefinitions="Auto, Auto, *"
        RowSpacing="20">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*, Auto"
            VerticalOptions="Center">

            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="NEXUS"
                    TextColor="{StaticResource PrimaryDark}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Quest Automator"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                Padding="10,5"
                BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse
                        Fill="{StaticResource Primary}"
                        HeightRequest="8"
                        VerticalOptions="Center"
                        WidthRequest="8" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="SYSTEM READY"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">

                <Border
                    Padding="15,10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, 55">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Auto-Accept New Quests"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />

                        <Switch
                            x:Name="AutoAcceptSwitch"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            IsToggled="True"
                            MinimumWidthRequest="0"
                            OnColor="{StaticResource Primary}"
                            VerticalOptions="Center"
                            WidthRequest="45" />
                    </Grid>
                </Border>

                <Button
                    x:Name="RunBtn"
                    Clicked="OnRunClicked"
                    CornerRadius="4"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="45"
                    Text="INITIALIZE QUESTS"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BtnSecondaryBgLight}, Dark={StaticResource BtnSecondaryBgDark}}"
                        Clicked="OnOpenDeleterClicked"
                        CornerRadius="4"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="40"
                        Text="Message Deleter"
                        TextColor="{AppThemeBinding Light={StaticResource BtnSecondaryTextLight}, Dark={StaticResource BtnSecondaryTextDark}}" />

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                        HeightRequest="40"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            IsRunning="False"
                            IsVisible="False"
                            VerticalOptions="Center"
                            WidthRequest="20"
                            Color="{StaticResource Primary}" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource MidnightBlue}"
            Stroke="{StaticResource Primary}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, *">
                <Grid
                    Grid.Row="0"
                    Padding="10,8"
                    BackgroundColor="#1A1A1A"
                    ColumnDefinitions="Auto, *, Auto">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text=">_"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Runtime Log"
                        TextColor="{StaticResource Gray300}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="2"
                        Padding="15,0"
                        BackgroundColor="{StaticResource Primary}"
                        Clicked="OnCopyLogClicked"
                        CornerRadius="4"
                        FontAttributes="Bold"
                        FontSize="11"
                        HeightRequest="26"
                        Text="Copy"
                        TextColor="White" />
                </Grid>

                <ScrollView
                    x:Name="LogScroll"
                    Grid.Row="1"
                    Padding="15">
                    <Label
                        x:Name="StatusLbl"
                        FontFamily="Consolas"
                        FontSize="12"
                        LineHeight="1.5"
                        Text="[SYS] Connecting to Discord API...&#10;[SYS] Awaiting authorization...&#10;[SYS] Standing by."
                        TextColor="{StaticResource Secondary}" />
                </ScrollView>
            </Grid>
        </Border>

        <Grid
            x:Name="ModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="#B3000000"
            IsVisible="False"
            Opacity="0"
            ZIndex="999">
            <Border
                Padding="20"
                BackgroundColor="{StaticResource MidnightBlue}"
                HorizontalOptions="Center"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="350">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label
                        x:Name="AlertTitleLbl"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="SYSTEM ALERT"
                        TextColor="White" />

                    <Label
                        x:Name="AlertMessageLbl"
                        FontSize="13"
                        LineHeight="1.4"
                        Text="This is a custom alert message."
                        TextColor="{StaticResource Gray200}" />

                    <Grid
                        Margin="0,10,0,0"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="10">
                        <Button
                            x:Name="AlertCancelBtn"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray600}"
                            BorderWidth="1"
                            Clicked="OnAlertCancelClicked"
                            CornerRadius="4"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36"
                            Text="Cancel"
                            TextColor="{StaticResource Gray200}" />

                        <Button
                            x:Name="AlertConfirmBtn"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnAlertConfirmClicked"
                            CornerRadius="4"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36"
                            Text="OK"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>