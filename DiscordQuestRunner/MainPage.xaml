<ContentPage
    x:Class="DiscordQuestRunner.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"
    NavigationPage.HasNavigationBar="False">

    <!-- Root container -->
    <Grid
        Padding="18,16,18,18"
        RowDefinitions="Auto, Auto, *, Auto"
        RowSpacing="14">

        <!-- --- HEADER ------------------------------------------------------- -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*, Auto">

            <!-- Brand + title -->
            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Accent bar -->
                    <BoxView
                        BackgroundColor="{StaticResource Primary}"
                        CornerRadius="2"
                        HeightRequest="20"
                        WidthRequest="4"
                        VerticalOptions="Center" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        CharacterSpacing="4"
                        Text="NEXUS :: DISCORD"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Margin="12,0,0,0"
                    Text="QUEST AUTOMATOR"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <!-- Status badge -->
            <Border
                Grid.Column="1"
                Padding="10,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <Ellipse
                        x:Name="StatusDot"
                        Fill="{StaticResource Primary}"
                        HeightRequest="8"
                        WidthRequest="8"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="StatusBadgeLbl"
                        CharacterSpacing="2"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="ONLINE"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- --- CONTROL PANEL ------------------------------------------------ -->
        <Border
            Grid.Row="1"
            Padding="18"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">

                <!-- Auto-accept toggle row -->
                <Border
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Icon column -->
                        <BoxView
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="2"
                            HeightRequest="16"
                            Margin="0,0,10,0"
                            WidthRequest="3"
                            VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="2"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="AUTO-ACCEPT QUESTS"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label
                                FontSize="10"
                                Text="Enrolls in all valid visible quests automatically"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Switch
                            x:Name="AutoAcceptSwitch"
                            Grid.Column="2"
                            HorizontalOptions="End"
                            IsToggled="True"
                            MinimumWidthRequest="0"
                            OnColor="{StaticResource Primary}"
                            VerticalOptions="Center"
                            WidthRequest="45" />
                    </Grid>
                </Border>

                <!-- Primary CTA -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Button
                        x:Name="RunBtn"
                        Grid.Column="0"
                        Clicked="OnRunClicked"
                        CornerRadius="5"
                        FontAttributes="Bold"
                        FontSize="13"
                        CharacterSpacing="2"
                        HeightRequest="46"
                        Text="INITIALIZE QUESTS"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" />

                    <!-- Loading indicator cell -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}"
                        HeightRequest="46"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        WidthRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            IsRunning="False"
                            IsVisible="False"
                            VerticalOptions="Center"
                            WidthRequest="20"
                            Color="{StaticResource Primary}" />
                    </Border>
                </Grid>

                <!-- Secondary action -->
                <Button
                    BackgroundColor="Transparent"
                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    BorderWidth="1"
                    Clicked="OnOpenDeleterClicked"
                    CornerRadius="5"
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    FontSize="11"
                    HeightRequest="38"
                    Text="?  MESSAGE PURGE"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <!-- --- RUNTIME LOG -------------------------------------------------- -->
        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource MidnightBlue}"
            Stroke="{StaticResource Primary}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, *">

                <!-- Log toolbar -->
                <Grid
                    Grid.Row="0"
                    Padding="12,7"
                    BackgroundColor="#121218"
                    ColumnDefinitions="Auto, *, Auto, Auto"
                    ColumnSpacing="8">

                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text=">_"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        CharacterSpacing="2"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="RUNTIME LOG"
                        TextColor="{StaticResource Gray400}"
                        VerticalOptions="Center" />

                    <!-- Line count badge -->
                    <Border
                        Grid.Column="2"
                        Padding="8,3"
                        BackgroundColor="#1E1E28"
                        Stroke="{StaticResource BorderDark}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Label
                            x:Name="LineCountLbl"
                            FontFamily="Consolas"
                            FontSize="10"
                            Text="3 lines"
                            TextColor="{StaticResource Gray500}"
                            VerticalOptions="Center" />
                    </Border>

                    <Button
                        Grid.Column="3"
                        Padding="12,0"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Clicked="OnCopyLogClicked"
                        CornerRadius="6"
                        FontAttributes="Bold"
                        FontSize="10"
                        CharacterSpacing="2"
                        HeightRequest="26"
                        Text="COPY"
                        TextColor="{StaticResource Primary}" />
                </Grid>

                <!-- Scrollable log output -->
                <ScrollView
                    x:Name="LogScroll"
                    Grid.Row="1"
                    Padding="14,12">
                    <Label
                        x:Name="StatusLbl"
                        FontFamily="Consolas"
                        FontSize="13"
                        LineHeight="1.6"
                        Text="[SYS] Connecting to Discord API...&#10;[SYS] Awaiting authorization...&#10;[SYS] Standing by."
                        TextColor="{StaticResource Secondary}" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- --- FOOTER ------------------------------------------------------- -->
        <Label
            Grid.Row="3"
            FontSize="10"
            HorizontalOptions="Center"
            Opacity="0.35"
            Text="NEXUS // Use responsibly • Check Discord ToS"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

        <!-- --- MODAL OVERLAY ------------------------------------------------ -->
        <Grid
            x:Name="ModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            BackgroundColor="Transparent"
            IsVisible="False"
            Opacity="1"
            ZIndex="999">
            <Border
                Padding="22"
                BackgroundColor="{StaticResource MidnightBlue}"
                HorizontalOptions="Center"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="340">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <!-- Modal header -->
                    <HorizontalStackLayout Spacing="10">
                        <BoxView
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="2"
                            HeightRequest="18"
                            WidthRequest="3"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="AlertTitleLbl"
                            CharacterSpacing="2"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="SYSTEM ALERT"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Divider -->
                    <BoxView
                        BackgroundColor="{StaticResource BorderDark}"
                        HeightRequest="1" />

                    <Label
                        x:Name="AlertMessageLbl"
                        FontSize="13"
                        LineHeight="1.5"
                        Text="This is a custom alert message."
                        TextColor="{StaticResource Gray200}" />

                    <Grid
                        Margin="0,6,0,0"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="10">
                        <Button
                            x:Name="AlertCancelBtn"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray600}"
                            BorderWidth="1"
                            Clicked="OnAlertCancelClicked"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="38"
                            Text="Cancel"
                            TextColor="{StaticResource Gray300}" />

                        <Button
                            x:Name="AlertConfirmBtn"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnAlertConfirmClicked"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="38"
                            Text="Confirm"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
