<ContentPage
    x:Class="DiscordQuestRunner.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight},
                                      Dark={StaticResource PageBgDark}}"
    NavigationPage.HasNavigationBar="False">
    <Grid
        Padding="25"
        RowDefinitions="Auto, Auto, *"
        RowSpacing="30">
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*, Auto"
            VerticalOptions="Center">
            <VerticalStackLayout Grid.Column="0" Spacing="-2">
                <Label
                    CharacterSpacing="4"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="NEXUS"
                    TextColor="{StaticResource PrimaryDark}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Text="Quest Automator"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                Padding="12,8"
                BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight},
                                                  Dark={StaticResource EntryBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight},
                                         Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Ellipse
                        Fill="{StaticResource Magenta}"
                        HeightRequest="8"
                        VerticalOptions="Center"
                        WidthRequest="8" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="SYSTEM READY"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                    Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight},
                                     Dark={StaticResource BorderDark}}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.1"
                    Radius="20"
                    Offset="0,10" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <Border
                    Margin="0,0,0,15"
                    Padding="15,10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight},
                                                      Dark={StaticResource EntryBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight},
                                             Dark={StaticResource BorderDark}}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, 55">
                        <Label
                            Grid.Column="0"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="AUTO-ACCEPT NEW QUESTS"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                        Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />

                        <Switch
                            x:Name="AutoAcceptSwitch"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            IsToggled="True"
                            MinimumWidthRequest="0"
                            OnColor="{StaticResource Magenta}"
                            VerticalOptions="Center"
                            WidthRequest="45" />
                    </Grid>
                </Border>
                <Button
                    x:Name="RunBtn"
                    CharacterSpacing="1.5"
                    Clicked="OnRunClicked"
                    CornerRadius="16"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="60"
                    Text="INITIALIZE QUESTS"
                    TextColor="White">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
                            <GradientStop Offset="1.0" Color="{StaticResource Magenta}" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow
                            Brush="{StaticResource Primary}"
                            Opacity="0.3"
                            Radius="15"
                            Offset="0,6" />
                    </Button.Shadow>
                </Button>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BtnSecondaryBgLight},
                                                          Dark={StaticResource BtnSecondaryBgDark}}"
                        Clicked="OnOpenDeleterClicked"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="48"
                        Text="MESSAGE DELETER"
                        TextColor="{AppThemeBinding Light={StaticResource BtnSecondaryTextLight},
                                                    Dark={StaticResource BtnSecondaryTextDark}}" />

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight},
                                                          Dark={StaticResource EntryBgDark}}"
                        HeightRequest="48"
                        StrokeThickness="0"
                        WidthRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <ActivityIndicator
                            x:Name="LoadingIndicator"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            IsRunning="False"
                            IsVisible="False"
                            VerticalOptions="Center"
                            WidthRequest="20"
                            Color="{StaticResource Magenta}" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            BackgroundColor="{StaticResource MidnightBlue}"
            Stroke="{StaticResource Primary}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, *">
                <Grid
                    Grid.Row="0"
                    Padding="15,12"
                    BackgroundColor="#000000"
                    ColumnDefinitions="Auto, *, Auto"
                    Opacity="0.4">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="Consolas"
                        FontSize="14"
                        Text="&gt;_"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="RUNTIME LOG"
                        TextColor="{StaticResource Gray300}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="2"
                        Padding="15,0"
                        BackgroundColor="{StaticResource Primary}"
                        Clicked="OnCopyLogClicked"
                        CornerRadius="6"
                        FontAttributes="Bold"
                        FontSize="10"
                        HeightRequest="28"
                        Text="COPY"
                        TextColor="White" />
                </Grid>

                <ScrollView
                    x:Name="LogScroll"
                    Grid.Row="1"
                    Padding="15,10,15,15">
                    <Label
                        x:Name="StatusLbl"
                        FontFamily="Consolas"
                        FontSize="12"
                        LineHeight="1.5"
                        Text="[SYS] Connecting to Discord API...&#10;[SYS] Awaiting authorization...&#10;[SYS] Standing by."
                        TextColor="{StaticResource Secondary}" />
                </ScrollView>
            </Grid>
        </Border>
        <Grid
            x:Name="ModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BackgroundColor="#CC000000"
            IsVisible="False"
            Opacity="0"
            ZIndex="999">
            <Border
                Padding="25"
                BackgroundColor="{StaticResource MidnightBlue}"
                HorizontalOptions="Center"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="350">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Primary}"
                        Opacity="0.4"
                        Radius="30"
                        Offset="0,0" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Ellipse
                            Fill="{StaticResource Magenta}"
                            HeightRequest="10"
                            VerticalOptions="Center"
                            WidthRequest="10" />
                        <Label
                            x:Name="AlertTitleLbl"
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="SYSTEM ALERT"
                            TextColor="White" />
                    </HorizontalStackLayout>

                    <Label
                        x:Name="AlertMessageLbl"
                        FontSize="13"
                        LineHeight="1.4"
                        Text="This is a custom alert message."
                        TextColor="{StaticResource Gray200}" />

                    <Grid
                        Margin="0,10,0,0"
                        ColumnDefinitions="*, *"
                        ColumnSpacing="10">
                        <Button
                            x:Name="AlertCancelBtn"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray600}"
                            BorderWidth="1"
                            Clicked="OnAlertCancelClicked"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="40"
                            Text="CANCEL"
                            TextColor="{StaticResource Gray200}" />

                        <Button
                            x:Name="AlertConfirmBtn"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnAlertConfirmClicked"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="40"
                            Text="CONFIRM"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
