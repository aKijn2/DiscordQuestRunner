<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
>
  <Color x:Key="Primary">#4F7CFF</Color>
  <Color x:Key="PrimaryDark">#9CB8FF</Color>
  <Color x:Key="PrimaryDarkText">#081120</Color>
  <Color x:Key="Secondary">#D7E4FF</Color>
  <Color x:Key="SecondaryDarkText">#8FA7DB</Color>
  <Color x:Key="Tertiary">#1F4FA8</Color>

  <Color x:Key="White">#FFFFFF</Color>
  <Color x:Key="Black">#050816</Color>
  <Color x:Key="Magenta">#F47174</Color>
  <Color x:Key="MidnightBlue">#0B1220</Color>
  <Color x:Key="OffBlack">#070C16</Color>

  <Color x:Key="Gray100">#F5F8FC</Color>
  <Color x:Key="Gray200">#DCE5F1</Color>
  <Color x:Key="Gray300">#BAC6D8</Color>
  <Color x:Key="Gray400">#94A3B8</Color>
  <Color x:Key="Gray500">#64748B</Color>
  <Color x:Key="Gray600">#334155</Color>
  <Color x:Key="Gray900">#0F172A</Color>
  <Color x:Key="Gray950">#020617</Color>

  <Color x:Key="Danger">#F47174</Color>
  <Color x:Key="Warning">#F3B23C</Color>
  <Color x:Key="Success">#2EB67D</Color>
  <Color x:Key="OverlayScrim">#90081220</Color>
  <Color x:Key="SurfaceAltLight">#F3F7FF</Color>
  <Color x:Key="SurfaceAltDark">#111C31</Color>
  <Color x:Key="SurfaceStrongDark">#0D1628</Color>
  <Color x:Key="LogHeaderLight">#EEF4FF</Color>
  <Color x:Key="LogHeaderDark">#101A2B</Color>

  <Color x:Key="PageBgLight">#F2F6FC</Color>
  <Color x:Key="PageBgDark">#07111F</Color>
  <Color x:Key="CardBgLight">#FCFDFE</Color>
  <Color x:Key="CardBgDark">#101A2E</Color>
  <Color x:Key="TextPrimaryLight">#0F172A</Color>
  <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
  <Color x:Key="TextSecondaryLight">#475569</Color>
  <Color x:Key="TextSecondaryDark">#94A3B8</Color>
  <Color x:Key="TextMutedLight">#64748B</Color>
  <Color x:Key="TextMutedDark">#5F7495</Color>
  <Color x:Key="AccentLight">#0F172A</Color>
  <Color x:Key="AccentDark">#E2EBFF</Color>
  <Color x:Key="BorderLight">#D3DEEC</Color>
  <Color x:Key="BorderDark">#22324B</Color>
  <Color x:Key="BtnPrimaryBgLight">#4F7CFF</Color>
  <Color x:Key="BtnPrimaryBgDark">#5B84FF</Color>
  <Color x:Key="BtnPrimaryTextLight">#FFFFFF</Color>
  <Color x:Key="BtnPrimaryTextDark">#FFFFFF</Color>
  <Color x:Key="BtnSecondaryBgLight">#EEF4FF</Color>
  <Color x:Key="BtnSecondaryBgDark">#15243B</Color>
  <Color x:Key="BtnSecondaryTextLight">#16243A</Color>
  <Color x:Key="BtnSecondaryTextDark">#DAE7FF</Color>
  <Color x:Key="EntryBgLight">#F7FAFF</Color>
  <Color x:Key="EntryBgDark">#0A1426</Color>
  <Color x:Key="EntryTextLight">#0F172A</Color>
  <Color x:Key="EntryTextDark">#F8FAFC</Color>
  <Color x:Key="PlaceholderLight">#7B8BA3</Color>
  <Color x:Key="PlaceholderDark">#607494</Color>
  <Color x:Key="DividerLight">#D3DEEC</Color>
  <Color x:Key="DividerDark">#20304D</Color>
  <Color x:Key="SpinnerLight">#4F7CFF</Color>
  <Color x:Key="SpinnerDark">#76A2FF</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
  <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

  <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
  <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
  <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
  <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
  <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
  <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
  <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
  <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
